{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instruktlabs.github.io/matter-field/schemas/receipts/common.schema.json",
  "title": "Matter Field receipt common definitions",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "sampleId": {
      "type": "string",
      "pattern": "^[ar][0-9]{4}$"
    },
    "extremeSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "z",
        "cpu",
        "gpu",
        "abs",
        "ulp"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sampleId"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "cpu": {
          "type": "number"
        },
        "gpu": {
          "type": "number"
        },
        "abs": {
          "type": "number",
          "minimum": 0
        },
        "ulp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "nonFiniteSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "x",
        "z",
        "cpu",
        "gpu"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sampleId"
        },
        "x": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "cpu": {
          "type": [
            "number",
            "null"
          ]
        },
        "gpu": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "fieldSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "budget",
        "maxAbs",
        "maxUlp",
        "finiteSamples",
        "nonFiniteCount",
        "pass",
        "maxAbsSample",
        "maxUlpSample",
        "firstNonFiniteSample"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxAbs": {
          "type": "number",
          "minimum": 0
        },
        "maxUlp": {
          "type": "integer",
          "minimum": 0
        },
        "finiteSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "nonFiniteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "pass": {
          "type": "boolean"
        },
        "maxAbsSample": {
          "anyOf": [
            {
              "$ref": "#/$defs/extremeSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "maxUlpSample": {
          "anyOf": [
            {
              "$ref": "#/$defs/extremeSample"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstNonFiniteSample": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonFiniteSample"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "nonFiniteCount": {
                "const": 0
              }
            },
            "required": [
              "nonFiniteCount"
            ]
          },
          "then": {
            "properties": {
              "finiteSamples": {
                "const": 300
              },
              "firstNonFiniteSample": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "finiteSamples": {
                "maximum": 299
              },
              "firstNonFiniteSample": {
                "$ref": "#/$defs/nonFiniteSample"
              },
              "pass": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "hashSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cpu",
        "gpu",
        "exact"
      ],
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uint32"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "cpu": {
          "$ref": "#/$defs/uint32"
        },
        "gpu": {
          "$ref": "#/$defs/uint32"
        },
        "exact": {
          "type": "boolean"
        }
      }
    },
    "hashSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bitExact",
        "count",
        "samples"
      ],
      "properties": {
        "bitExact": {
          "type": "boolean"
        },
        "count": {
          "const": 11
        },
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hashSample"
          },
          "minItems": 11,
          "maxItems": 11
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "bitExact": {
                "const": true
              }
            },
            "required": [
              "bitExact"
            ]
          },
          "then": {
            "properties": {
              "samples": {
                "items": {
                  "properties": {
                    "exact": {
                      "const": true
                    }
                  },
                  "required": [
                    "exact"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "samples": {
                "contains": {
                  "properties": {
                    "exact": {
                      "const": false
                    }
                  },
                  "required": [
                    "exact"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "webGpuAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "vendor",
        "architecture",
        "device",
        "description"
      ],
      "properties": {
        "api": {
          "const": "WebGPU"
        },
        "vendor": {
          "type": "string"
        },
        "architecture": {
          "type": "string"
        },
        "device": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "webGl2Adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "vendor",
        "renderer",
        "version",
        "shadingLanguageVersion"
      ],
      "properties": {
        "api": {
          "const": "WebGL2"
        },
        "vendor": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "shadingLanguageVersion": {
          "type": "string"
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "userAgent"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "userAgent": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "release",
        "arch"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "chromeGpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "devices",
        "driverBugWorkarounds",
        "featureStatus"
      ],
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vendorId": {
                "$ref": "#/$defs/uint32"
              },
              "deviceId": {
                "$ref": "#/$defs/uint32"
              },
              "subSysId": {
                "$ref": "#/$defs/uint32"
              },
              "revision": {
                "$ref": "#/$defs/uint32"
              },
              "vendorString": {
                "type": "string"
              },
              "deviceString": {
                "type": "string"
              },
              "driverVendor": {
                "type": "string"
              },
              "driverVersion": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "driverBugWorkarounds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "featureStatus": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "nativeRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headed",
        "generatedAt",
        "node",
        "package",
        "three",
        "commit",
        "dirty",
        "browserArgs",
        "softwareAdapter"
      ],
      "properties": {
        "headed": {
          "type": "boolean"
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "node": {
          "type": "string",
          "pattern": "^v[0-9]+\\."
        },
        "package": {
          "type": "string",
          "pattern": "^matter-field@[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "three": {
          "$ref": "#/$defs/semver"
        },
        "implementation": {
          "const": "adapter"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "dirty": {
          "type": "boolean"
        },
        "browserArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "softwareAdapter": {
          "type": "boolean"
        }
      }
    },
    "typegpuRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headed",
        "generatedAt",
        "node",
        "package",
        "three",
        "implementation",
        "typegpu",
        "typegpuThree",
        "commit",
        "dirty",
        "browserArgs",
        "softwareAdapter"
      ],
      "properties": {
        "headed": {
          "type": "boolean"
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "node": {
          "type": "string",
          "pattern": "^v[0-9]+\\."
        },
        "package": {
          "type": "string",
          "pattern": "^matter-field@[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "three": {
          "$ref": "#/$defs/semver"
        },
        "implementation": {
          "const": "typegpu"
        },
        "typegpu": {
          "$ref": "#/$defs/semver"
        },
        "typegpuThree": {
          "$ref": "#/$defs/semver"
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "dirty": {
          "type": "boolean"
        },
        "browserArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "softwareAdapter": {
          "type": "boolean"
        }
      }
    }
  }
}
