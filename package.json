{
  "name": "matter-field",
  "version": "0.0.1",
  "description": "Authoritative procedural fields with measured CPU/GPU drift, analytic gradients, native TSL, and optional TypeGPU integration.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instruktlabs/matter-field.git"
  },
  "bugs": {
    "url": "https://github.com/instruktlabs/matter-field/issues"
  },
  "homepage": "https://instruktlabs.github.io/matter-field/",
  "files": [
    "src/",
    "dist-types/",
    "dist-typegpu/",
    "schemas/",
    "benchmarks/",
    "parity/harness.js",
    "parity/golden.js",
    "parity/reports/",
    "examples/",
    "docs/",
    "ROADMAP.md",
    "PROVENANCE.md",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist-types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./typegpu": {
      "types": "./dist-typegpu/index.d.ts",
      "default": "./dist-typegpu/index.js"
    },
    "./typegpu/three": {
      "types": "./dist-typegpu/three.d.ts",
      "default": "./dist-typegpu/three.js"
    },
    "./adapter-core": {
      "types": "./dist-types/src/index.d.ts",
      "default": "./src/index.js"
    },
    "./adapter": {
      "types": "./dist-types/src/adapter.d.ts",
      "default": "./src/adapter.js"
    },
    "./number": {
      "types": "./dist-types/src/number.d.ts",
      "default": "./src/number.js"
    },
    "./hash": {
      "types": "./dist-types/src/hash.d.ts",
      "default": "./src/hash.js"
    },
    "./dual": {
      "types": "./dist-types/src/dual.d.ts",
      "default": "./src/dual.js"
    },
    "./noise": {
      "types": "./dist-types/src/noise.d.ts",
      "default": "./src/noise.js"
    },
    "./backend-tsl": {
      "types": "./dist-types/src/backend-tsl.d.ts",
      "default": "./src/backend-tsl.js"
    },
    "./parity": {
      "types": "./dist-types/parity/harness.d.ts",
      "default": "./parity/harness.js"
    },
    "./parity/golden": {
      "types": "./dist-types/parity/golden.d.ts",
      "default": "./parity/golden.js"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:browsers": "node scripts/run-cpu-browser-parity.mjs",
    "test:package": "npm pack --dry-run",
    "build:typegpu": "node scripts/build-typegpu.mjs",
    "build:typegpu:package": "node scripts/build-typegpu-package.mjs",
    "test:ir:build": "node --test tooling-tests/canonical-ir-build-check.mjs",
    "test:typegpu:build": "node --test tooling-tests/typegpu-build-check.mjs",
    "test:typegpu:types": "npm run build:typegpu:package && tsc -p tsconfig.typegpu.json",
    "test:typegpu:consumer": "node scripts/verify-typegpu-package.mjs",
    "check:js": "node node_modules/typescript-upstream/bin/tsc -p tsconfig.check.json",
    "build:types": "node scripts/build-types.mjs",
    "test:types": "npm run check:js && npm run build:types",
    "prepack": "npm run build:types && npm run build:typegpu:package",
    "prepublishOnly": "node scripts/check-publish-readiness.mjs",
    "assay": "node examples/demo.mjs",
    "bench": "node examples/bench.mjs",
    "bench:cpu:self-test": "node --test benchmarks/self-test.mjs",
    "bench:cpu": "node benchmarks/run-cpu.mjs",
    "probe:build": "node scripts/build-gpu-probe.mjs",
    "probe:gpu": "node scripts/run-gpu-probe.mjs --backend=webgpu",
    "probe:webgl2": "node scripts/run-gpu-probe.mjs --backend=webgl2",
    "probe:typegpu": "node scripts/run-gpu-probe.mjs --implementation=typegpu --backend=webgpu",
    "probe:typegpu:build": "node scripts/build-typegpu-probe.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:smoke": "node scripts/smoke-site.mjs",
    "site:serve": "node scripts/serve-site.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@typegpu/three": "0.11.0",
    "@types/three": "0.185.4",
    "three": "0.185.1",
    "typegpu": "0.11.9"
  },
  "peerDependenciesMeta": {
    "@typegpu/three": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    }
  },
  "keywords": [
    "procedural",
    "terrain",
    "noise",
    "deterministic",
    "cpu-gpu-parity",
    "typegpu",
    "tsl",
    "webgpu",
    "shader"
  ],
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@typegpu/three": "0.11.0",
    "@types/three": "0.185.4",
    "@webgpu/types": "0.1.71",
    "ajv": "8.20.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.59.1",
    "three": "0.185.1",
    "typegpu": "0.11.9",
    "typescript": "npm:tsover@6.0.2",
    "typescript-upstream": "npm:typescript@7.0.2",
    "unplugin-typegpu": "0.11.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
