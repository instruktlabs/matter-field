{
  "name": "matter-field",
  "version": "0.0.1",
  "description": "Authoritative procedural fields with measured CPU/GPU parity, analytic gradients, native TSL, and a first-class TypeGPU/WebGPU materialization.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instruktlabs/matter-field.git"
  },
  "bugs": {
    "url": "https://github.com/instruktlabs/matter-field/issues"
  },
  "homepage": "https://instruktlabs.github.io/matter-field/",
  "files": [
    "src/",
    "dist-typegpu/",
    "parity/harness.js",
    "parity/golden.js",
    "examples/",
    "docs/",
    "ROADMAP.md",
    "PROVENANCE.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./typegpu": {
      "types": "./dist-typegpu/index.d.ts",
      "default": "./dist-typegpu/index.js"
    },
    "./typegpu/three": {
      "types": "./dist-typegpu/three.d.ts",
      "default": "./dist-typegpu/three.js"
    },
    "./adapter-core": "./src/index.js",
    "./adapter": "./src/adapter.js",
    "./number": "./src/number.js",
    "./hash": "./src/hash.js",
    "./dual": "./src/dual.js",
    "./noise": "./src/noise.js",
    "./backend-tsl": "./src/backend-tsl.js",
    "./parity": "./parity/harness.js",
    "./parity/golden": "./parity/golden.js"
  },
  "scripts": {
    "test": "node --test",
    "test:browsers": "node scripts/run-cpu-browser-parity.mjs",
    "test:package": "npm pack --dry-run",
    "build:typegpu": "node scripts/build-typegpu.mjs",
    "build:typegpu:package": "node scripts/build-typegpu-package.mjs",
    "test:typegpu:build": "node --test tooling-tests/typegpu-build-check.mjs",
    "test:typegpu:types": "npm run build:typegpu:package && tsc -p tsconfig.typegpu.json",
    "test:typegpu:consumer": "node scripts/verify-typegpu-package.mjs",
    "prepack": "npm run build:typegpu:package",
    "prepublishOnly": "node scripts/check-publish-readiness.mjs",
    "assay": "node examples/demo.mjs",
    "bench": "node examples/bench.mjs",
    "probe:build": "node scripts/build-gpu-probe.mjs",
    "probe:gpu": "node scripts/run-gpu-probe.mjs --backend=webgpu",
    "probe:webgl2": "node scripts/run-gpu-probe.mjs --backend=webgl2",
    "probe:typegpu": "node scripts/run-gpu-probe.mjs --implementation=typegpu --backend=webgpu",
    "probe:typegpu:build": "node scripts/build-typegpu-probe.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:serve": "node scripts/serve-site.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@typegpu/three": "0.11.0",
    "@types/three": "0.185.4",
    "three": "0.185.1",
    "typegpu": "0.11.9"
  },
  "peerDependenciesMeta": {
    "@typegpu/three": {
      "optional": true
    },
    "@types/three": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "typegpu": {
      "optional": true
    }
  },
  "keywords": [
    "procedural",
    "terrain",
    "noise",
    "deterministic",
    "cpu-gpu-parity",
    "typegpu",
    "tsl",
    "webgpu",
    "shader"
  ],
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@typegpu/three": "0.11.0",
    "@types/three": "0.185.4",
    "@webgpu/types": "0.1.71",
    "esbuild": "^0.28.2",
    "playwright": "^1.59.1",
    "three": "0.185.1",
    "typegpu": "0.11.9",
    "typescript": "npm:tsover@6.0.2",
    "unplugin-typegpu": "0.11.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
